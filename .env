# Конфигурация сервера
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_SHUTDOWN_TIMEOUT=5

# Конфигурация базы данных PostgreSQL
DB_HOST=localhost
DB_USER=ibs
DB_PASSWORD=ibs
DB_NAME=todo_db
DB_PORT=5432
DB_SSLMODE=disable

# Пул соединений к базе данных
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100


# Конфигурация логгера
LOG_LEVEL=info
LOG_FILENAME=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=5
LOG_COMPRESS=true
LOG_LOCAL_TIME=true
LOG_ROTATE_DAILY=false

# Конфигурация трассировки (OpenTelemetry/Jaeger)
TRACE_ENABLED=true
TRACE_URL=localhost:4318
TRACE_SERVICE_NAME=go-todo-service
TRACE_HTTP_BODY_ENABLED=true
