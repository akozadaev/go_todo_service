# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_SHUTDOWN_TIMEOUT=5
GIN_MODE=debug
GRPC_REFLECTION_ENABLED=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=todo_db
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Logging Configuration
LOG_LEVEL=info                    # debug, info, warn, error, fatal
LOG_FORMAT=json                   # json или text
LOG_FILENAME=logs/app.log         # путь к файлу лога (пустая строка = только stdout)
LOG_MAX_SIZE=100                  # максимальный размер файла в MB
LOG_MAX_AGE=30                    # максимальный возраст файла в днях
LOG_MAX_BACKUPS=5                 # максимальное количество резервных файлов
LOG_COMPRESS=true                 # сжимать старые файлы
LOG_LOCAL_TIME=true               # использовать локальное время для имен файлов
LOG_ROTATE_DAILY=false            # ротация по дням (в дополнение к размеру)
LOG_ENABLE_STDOUT=false           # дублировать в stdout для разработки

# Tracing Configuration
TRACE_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=go-todo-service
SERVICE_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=development
TRACE_SAMPLE_RATIO=1
